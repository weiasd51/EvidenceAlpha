@import "tailwindcss";

:root {
  --ink: #10231d;
  --muted: #65736e;
  --paper: #f4f1e9;
  --panel: #fffdf8;
  --line: #d9ddd5;
  --green: #0c7657;
  --green-dark: #07503d;
  --lime: #c9f45b;
  --red: #bd4f42;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
}
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
main { min-height: 100vh; }
.topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5vw;
  border-bottom: 1px solid rgba(16, 35, 29, .14);
  background: rgba(244, 241, 233, .9);
  backdrop-filter: blur(14px);
  position: sticky;
  top: 0;
  z-index: 20;
}
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  background: var(--ink);
  color: var(--lime);
  font: 700 12px/1 var(--font-geist-mono), monospace;
  letter-spacing: .08em;
}
.brand div { display: grid; gap: 2px; }
.brand strong { font-size: 15px; letter-spacing: -.01em; }
.brand div span { color: var(--muted); font-size: 11px; }
nav { display: flex; gap: 34px; font-size: 13px; }
nav a:hover { color: var(--green); }
.status { display: flex; align-items: center; gap: 8px; font: 12px var(--font-geist-mono), monospace; color: var(--muted); }
.status i { width: 7px; height: 7px; border-radius: 50%; background: #c9932d; box-shadow: 0 0 0 4px rgba(201, 147, 45, .13); }
.status.online i { background: var(--green); box-shadow: 0 0 0 4px rgba(12, 118, 87, .13); }
.hero {
  min-height: 555px;
  padding: 88px 7vw 72px;
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 8vw;
  align-items: center;
  background:
    linear-gradient(90deg, transparent 49.9%, rgba(16, 35, 29, .055) 50%, transparent 50.1%),
    linear-gradient(rgba(16, 35, 29, .04) 1px, transparent 1px);
  background-size: 72px 100%, 100% 72px;
}
.eyebrow { margin: 0 0 14px; color: var(--green); font: 700 11px/1.3 var(--font-geist-mono), monospace; letter-spacing: .14em; }
.hero h1 { margin: 0; max-width: 760px; font-size: clamp(48px, 6vw, 82px); line-height: .99; letter-spacing: -.07em; }
.lede { max-width: 650px; margin: 30px 0 0; color: var(--muted); font-size: 16px; line-height: 1.9; }
.research-box { background: var(--ink); color: white; padding: 28px; box-shadow: 14px 14px 0 rgba(12, 118, 87, .15); }
.command-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; font-size: 13px; }
.step-mark { color: #8fa099; font: 10px var(--font-geist-mono), monospace; letter-spacing: .08em; }
.research-box label { display: grid; gap: 8px; color: #aeb9b4; font-size: 11px; letter-spacing: .05em; }
.research-box input, .research-box select { width: 100%; border: 1px solid #486057; background: #19352c; color: white; padding: 14px 13px; outline: none; }
.research-box input { font: 600 20px var(--font-geist-mono), monospace; letter-spacing: .08em; }
.research-box input:focus, .research-box select:focus { border-color: var(--lime); }
.field-row { display: grid; grid-template-columns: 1fr 1.3fr; gap: 12px; margin: 16px 0; }
.field-help { color: #80938b; font-size: 10px; line-height: 1.5; letter-spacing: 0; }
.parameter-explainers { display: grid; gap: 1px; margin: 18px 0; background: #365046; border: 1px solid #365046; }
.parameter-explainers div { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 10px; padding: 10px 12px; background: #19352c; }
.parameter-explainers b { color: var(--lime); font: 700 11px var(--font-geist-mono), monospace; }
.parameter-explainers span { color: #b3c0bb; font-size: 10px; line-height: 1.45; }
.research-box button { width: 100%; border: 0; background: var(--lime); color: var(--ink); padding: 15px; font-weight: 800; cursor: pointer; }
.research-box button:hover { background: #d9ff78; }
.research-box button:disabled { opacity: .6; cursor: wait; }
.form-note { margin: 14px 0 0; color: #8fa099; text-align: center; font-size: 10px; }
.notice { margin: 0 5vw; border: 1px solid var(--line); border-top: 0; padding: 11px 18px; color: var(--muted); background: rgba(255,255,255,.35); font-size: 12px; }
.notice span { color: var(--ink); font-weight: 700; margin-right: 14px; }
.metrics-grid { margin: 42px 5vw; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); background: var(--panel); }
.metrics-grid article { padding: 24px 26px; display: grid; gap: 8px; border-right: 1px solid var(--line); }
.metrics-grid article:last-child { border-right: 0; }
.metrics-grid span, .metrics-grid small { color: var(--muted); font-size: 11px; }
.metrics-grid strong { font: 600 34px var(--font-geist-mono), monospace; letter-spacing: -.04em; }
.metrics-grid strong.positive { color: var(--green); }
.workspace { margin: 0 5vw; display: grid; grid-template-columns: 1.35fr .85fr; border: 1px solid var(--line); background: var(--panel); }
.decision-panel { padding: 36px; border-right: 1px solid var(--line); }
.trace-panel { padding: 36px 30px; background: #edf0e9; }
.section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
.section-heading h2 { margin: 0; font-size: 27px; letter-spacing: -.035em; }
.section-heading h2 span { color: var(--muted); font: 500 13px var(--font-geist-mono), monospace; margin-left: 7px; }
.section-heading > p { max-width: 440px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
.section-heading.compact { align-items: start; }
.signal { padding: 9px 14px; font-size: 12px; font-weight: 800; border: 1px solid currentColor; }
.signal.bullish { color: var(--green); background: #e9f6ee; }
.signal.bearish { color: var(--red); background: #f9eeeb; }
.signal.neutral { color: #806b32; background: #f5f0df; }
.confidence-row { display: grid; grid-template-columns: 100px 1fr auto; align-items: center; gap: 20px; margin: 34px 0 26px; }
.confidence-row div:first-child { display: grid; gap: 2px; }
.confidence-row small { color: var(--muted); font-size: 10px; }
.confidence-row strong { font: 600 28px var(--font-geist-mono), monospace; }
.confidence-track { height: 5px; background: #d9e0da; }
.confidence-track i { display: block; height: 100%; background: var(--green); }
.confidence-row > span { font: 600 12px var(--font-geist-mono), monospace; }
.conclusion { font-size: 16px; line-height: 1.95; margin: 0; }
.output-definition { display: grid; grid-template-columns: 76px 1fr; gap: 14px; padding: 14px 16px; margin-bottom: 20px; background: #edf3ed; border-left: 3px solid var(--green); }
.output-definition > span { color: var(--green); font-size: 10px; font-weight: 800; }
.output-definition p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
.output-definition b { color: var(--ink); }
.range-row { display: grid; grid-template-columns: 1.2fr 1fr .8fr; gap: 16px; padding: 24px 0; margin-top: 26px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.range-row div { display: grid; gap: 6px; }
.range-row small, .risk-box > span { color: var(--muted); font-size: 10px; }
.range-row strong { font: 600 13px var(--font-geist-mono), monospace; }
.risk-box { padding-top: 24px; }
.risk-box ul { margin: 10px 0 0; padding-left: 18px; color: var(--red); font-size: 12px; line-height: 1.8; }
.run-id { font: 11px var(--font-geist-mono), monospace; color: var(--muted); }
.trace-list { list-style: none; padding: 0; margin: 30px 0 0; }
.trace-list li { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; padding: 0 0 22px; position: relative; }
.trace-list li:not(:last-child)::before { content: ""; position: absolute; left: 13px; top: 27px; bottom: 0; width: 1px; background: #bfc9c2; }
.trace-index { width: 27px; height: 27px; display: grid; place-items: center; background: var(--ink); color: var(--lime); font: 10px var(--font-geist-mono), monospace; z-index: 1; }
.trace-list strong { display: block; text-transform: uppercase; font: 700 11px var(--font-geist-mono), monospace; }
.trace-list p { margin: 5px 0 0; color: var(--muted); font-size: 11px; line-height: 1.55; }
.trace-list time { color: var(--muted); font: 10px var(--font-geist-mono), monospace; }
.evidence-section, .evaluation-section { margin: 86px 5vw 0; }
.evidence-list { margin-top: 24px; border-top: 1px solid var(--ink); }
.evidence-list article { display: grid; grid-template-columns: 22px 1fr 180px; gap: 18px; padding: 23px 14px; border-bottom: 1px solid var(--line); align-items: start; }
.stance-dot { margin-top: 7px; width: 8px; height: 8px; border-radius: 50%; background: #9b9b9b; }
.stance-dot.bullish { background: var(--green); }
.stance-dot.bearish { background: var(--red); }
.evidence-main > div { display: flex; align-items: center; gap: 12px; }
.type-tag { padding: 4px 7px; background: #e2e8df; color: var(--green-dark); font-size: 10px; }
.evidence-main time { color: var(--muted); font: 10px var(--font-geist-mono), monospace; }
.evidence-main h3 { margin: 9px 0 6px; font-size: 15px; }
.evidence-main p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
.evidence-source { display: grid; gap: 6px; justify-items: end; text-align: right; }
.evidence-source small { color: var(--muted); font-size: 9px; }
.evidence-source strong { font-size: 11px; }
.evidence-source span { color: var(--green); font: 10px var(--font-geist-mono), monospace; }
.evaluation-section { padding-bottom: 90px; }
.evaluation-grid { margin-top: 26px; display: grid; grid-template-columns: 1.4fr .6fr; border: 1px solid var(--line); background: var(--panel); }
.experiment-table { padding: 12px 28px; }
.table-head, .table-row { display: grid; grid-template-columns: 2fr repeat(3, 1fr); padding: 17px 0; align-items: center; border-bottom: 1px solid var(--line); }
.table-head { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
.table-row { font: 12px var(--font-geist-mono), monospace; }
.table-row strong { color: var(--green-dark); text-transform: capitalize; }
.empty-row { padding: 35px 0; color: var(--muted); font-size: 12px; }
.experiment-callout { padding: 32px; background: var(--ink); color: white; }
.experiment-callout > strong { display: block; color: var(--lime); font-size: 25px; text-transform: capitalize; }
.experiment-callout > p:not(.eyebrow) { color: #aeb9b4; font-size: 12px; line-height: 1.7; margin: 14px 0 26px; }
.experiment-callout > div { display: flex; justify-content: space-between; padding: 13px 0; border-top: 1px solid #365046; font-size: 11px; }
.experiment-callout b { color: var(--lime); font: 600 13px var(--font-geist-mono), monospace; }
footer { min-height: 140px; padding: 40px 5vw; display: flex; align-items: center; justify-content: space-between; background: var(--ink); color: white; }
footer p, footer > span { color: #8fa099; font-size: 11px; }

@media (max-width: 900px) {
  nav { display: none; }
  .hero { grid-template-columns: 1fr; padding-top: 60px; }
  .metrics-grid { grid-template-columns: 1fr 1fr; }
  .metrics-grid article:nth-child(2) { border-right: 0; }
  .metrics-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  .workspace, .evaluation-grid { grid-template-columns: 1fr; }
  .decision-panel { border-right: 0; border-bottom: 1px solid var(--line); }
}

@media (max-width: 620px) {
  .topbar { padding: 0 20px; }
  .status { font-size: 0; }
  .hero { padding: 54px 20px; }
  .hero h1 { font-size: 47px; }
  .metrics-grid, .workspace, .evidence-section, .evaluation-section { margin-left: 20px; margin-right: 20px; }
  .metrics-grid { grid-template-columns: 1fr; }
  .metrics-grid article { border-right: 0; border-bottom: 1px solid var(--line); }
  .decision-panel, .trace-panel { padding: 26px 20px; }
  .range-row { grid-template-columns: 1fr; }
  .evidence-list article { grid-template-columns: 18px 1fr; }
  .evidence-source { grid-column: 2; justify-items: start; text-align: left; }
  .section-heading { align-items: start; flex-direction: column; }
  footer { align-items: start; flex-direction: column; gap: 20px; }
}
